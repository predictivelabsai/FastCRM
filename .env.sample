# --- FastCRM ---------------------------------------------------------------
# Copy to `.env` and fill in. `.env` is gitignored — never commit secrets.

# Admin login (override the demo defaults in any real deployment!)
FASTCRM_ADMIN_EMAIL=admin@fastcrm.example
FASTCRM_ADMIN_PASSWORD=FastCRM2026$

# Long random hex; leave blank to auto-generate a per-boot secret (sessions
# reset on restart). Set a fixed value to keep users logged in across restarts.
FASTCRM_SECRET=

# HTTP port and the label shown in the top bar.
FASTCRM_PORT=5006
FASTCRM_ENV_LABEL=FastCRM

# Path to the SQLite database. Blank => ./fastcrm.sqlite next to the app.
# In Docker, mount a volume and point this at it, e.g. /data/fastcrm.sqlite
FASTCRM_DB=

# --- AI assistant ----------------------------------------------------------
# Free-form chat uses one provider; slash-commands (/pipeline, /leads …) work
# with no key at all. Pick a provider and set the matching key.
#   MODEL_PROVIDER: xai | openai | anthropic | google
MODEL_PROVIDER=xai
MODEL_NAME=grok-4-1-fast-reasoning

XAI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Google SSO
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://crm.fastsme.com/auth/google/callback
GOOGLE_ALLOWED_DOMAINS=
GOOGLE_ALLOWED_EMAILS=

# FastSME local accounts and transactional email
FASTSME_AUTH_DB=
FASTSME_PUBLIC_URL=https://crm.fastsme.com
POSTMARK_API_TOKEN=
FROM_EMAIL=info@predictivelabs.ai

# Public reads need no credential; set this to enable bearer-token API writes.
FASTSME_API_TOKEN=
